# Backend & Service URLs (Client-side inlined by Vite)
# URL gateway companion Pet Owner API (upload foto, Nominatim proxy, SlivaCare, chat Socket.IO)
NEXT_PUBLIC_PETOWNER_API_URL=http://localhost:8090
# URL backend platform API utama Slivadoc (auth, booking, profil, rekam medis, adopsi, shop)
NEXT_PUBLIC_PLATFORM_API_URL=http://localhost:8080
# URL realtime service untuk chat dan media WebRTC SFU konsultasi
NEXT_PUBLIC_REALTIME_URL=http://localhost:8091
# URL kanonikal publik untuk sitemap, RSS feed, OpenGraph metadata, dan schema JSON-LD
NEXT_PUBLIC_SITE_URL=https://slivadoc.id

# Search Engine & Indexing (Server-side / build-time)
# Kode verifikasi kepemilikan domain Google Search Console (tag HTML)
GOOGLE_SITE_VERIFICATION=
# Kode verifikasi kepemilikan domain Bing Webmaster Tools (meta tag msvalidate.01)
BING_SITE_VERIFICATION=
# API key IndexNow untuk notifikasi instan perubahan URL ke mesin pencari
INDEXNOW_KEY=
# Secret token otorisasi Bearer untuk endpoint webhook /api/seo/indexnow
SEO_WEBHOOK_SECRET=
