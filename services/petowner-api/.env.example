PORT=8090
# Jumlah reverse proxy hop sebelum aplikasi (contoh: 1 untuk Caddy/Docker Compose, 0 untuk local dev langsung)
TRUST_PROXY_HOPS=0
# Daftar origin web (tanpa trailing slash). Di development, localhost:3000, 3001, 5173, 8081 otomatis diizinkan.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:8081
# URL backend utama Slivadoc (wajib diset pada container / staging / production)
SLIVADOC_API_URL=http://localhost:8080
# Cloudinary - server-side only
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=slivadoc/petowner

# OpenAI - server-side only
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Free OpenStreetMap/Nominatim geocoder for development/testing
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=SlivadocPetOwner/0.1 (https://github.com/S-V2/slivadoc-petowner)
