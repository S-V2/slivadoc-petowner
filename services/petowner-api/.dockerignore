# Build context is services/petowner-api. This file governs that context only;
# the repo-root .dockerignore does not apply here.

# VCS
.git
.gitignore

# The deps stage runs its own `npm ci --omit=dev`.
node_modules

# Runtime state, never baked into the image. DATA_DIR is a mounted volume at
# /data; petowner.json lives there, not in the build context.
data

# Secrets: exclude every .env variant, but keep the checked-in template.
.env
.env.*
!.env.example

# Editor / OS noise
.DS_Store
*.swp
.idea
.vscode

# Not needed to build or run the image
Dockerfile
.dockerignore
test
