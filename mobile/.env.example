# Development:
# Android Emulator otomatis memakai http://10.0.2.2:8090 jika variabel ini kosong.
# iOS Simulator otomatis memakai http://localhost:8090 jika variabel ini kosong.
# HP fisik via Expo Go: isi dengan IP LAN komputer (contoh: http://192.168.1.10:8090).

# URL gateway companion Pet Owner API untuk upload foto, lokasi, SlivaCare, dan chat
EXPO_PUBLIC_PETOWNER_API_URL=http://192.168.1.10:8090
# URL platform API utama Slivadoc untuk auth, booking, riwayat, rekam medis, dan profil
EXPO_PUBLIC_PLATFORM_API_URL=http://192.168.1.10:8080
# URL gateway Socket.IO dan signaling WebRTC untuk chat care tim realtime
EXPO_PUBLIC_REALTIME_URL=http://192.168.1.10:8091

# Production / EAS Build Profile:
# Profil build EAS (development, preview, production) - production memvalidasi semua URL HTTPS publik
EAS_BUILD_PROFILE=development
