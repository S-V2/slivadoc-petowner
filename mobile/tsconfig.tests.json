{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [
      "node"
    ],
    "lib": [
      "esnext",
      "dom"
    ],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "assets.d.ts",
    "tests/**/*.mts",
    "tests/ui/**/*.ts",
    "tests/ui/**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}
