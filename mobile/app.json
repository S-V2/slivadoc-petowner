{
  "expo": {
    "name": "Slivadoc",
    "slug": "slivadoc-pet-owner",
    "owner": "s-v2",
    "version": "0.1.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "default",
    "userInterfaceStyle": "light",
    "scheme": "slivadoc",
    "androidStatusBar": {
      "backgroundColor": "#F5FBFE",
      "barStyle": "dark-content",
      "translucent": false
    },
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.slivadoc.petowner",
      "infoPlist": {
        "NSCameraUsageDescription": "Slivadoc menggunakan kamera untuk foto profil hewan dan dokumen kesehatan.",
        "NSPhotoLibraryUsageDescription": "Slivadoc menggunakan galeri untuk melampirkan foto dan dokumen hewan.",
        "NSLocationWhenInUseUsageDescription": "Slivadoc menggunakan lokasi untuk menemukan layanan dan komunitas hewan terdekat."
      }
    },
    "android": {
      "package": "com.slivadoc",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EAF8FF"
      },
      "predictiveBackGestureEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 176,
          "backgroundColor": "#F6FBFF"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Izinkan Slivadoc menggunakan lokasi untuk menemukan layanan hewan terdekat."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Izinkan Slivadoc memilih foto hewan dan dokumen kesehatan."
        }
      ],
      "expo-secure-store",
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "db196d33-c3da-4046-8a30-4715755458c3"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/db196d33-c3da-4046-8a30-4715755458c3"
    }
  }
}
