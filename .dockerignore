# Build context hygiene. Keep this in sync across the five Sliva site repos.

# VCS
.git
.gitignore

# Never ship or invalidate cache on installed/generated trees; the build stage
# runs its own `npm ci` and `npx vinext build`.
node_modules
dist
.next
.wrangler

# Local sandbox scratch created by scripts/sites-env.sh:5-12
.sites-runtime

# Secrets: exclude every .env variant, but keep the checked-in template.
.env
.env.*
!.env.example

# Editor / OS noise
.DS_Store
*.swp
.idea
.vscode

# Not needed to build or run the image
Dockerfile
.dockerignore
.github
README.md
examples
tests

# Expo React Native client — built by EAS, never part of the web image, and the
# single largest thing in this repo's context (PNG splash/hero/icon assets).
mobile

# The Pet Owner API ships from its own Dockerfile with its own build context
# (services/petowner-api), so it is dead weight in the web image context.
services
