# Gunakan IP LAN komputer saat dibuka dari HP fisik, contoh: http://192.168.1.10:8090
# Android Emulator otomatis memakai http://10.0.2.2:8090 jika variabel ini kosong.
# iOS Simulator otomatis memakai http://localhost:8090 jika variabel ini kosong.
EXPO_PUBLIC_PETOWNER_API_URL=http://192.168.1.10:8090
# API utama Slivadoc untuk Academy, Event, PetSpot, dan PetHub.
EXPO_PUBLIC_PLATFORM_API_URL=http://192.168.1.10:8080
# Gateway Socket.IO dan signaling WebRTC konsultasi dokter.
EXPO_PUBLIC_REALTIME_URL=http://192.168.1.10:8091

# Build preview/production wajib mengatur ketiga variabel di EAS Environment.
# Gunakan URL HTTPS publik; localhost, emulator, dan IP LAN akan ditolak untuk
# profile production agar binary release tidak diam-diam gagal mengambil data.
